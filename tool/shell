#!/usr/bin/env bash

checkout=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P) || exit 1
shell_script="$checkout/operating_system/operating_system-windows/tool/shell"
if [[ ! -f "$shell_script" ]]; then
    printf '%s\n' 'The Windows tool submodule is missing. Run git submodule update --init --recursive.' >&2
    exit 1
fi

exec bash "$shell_script" "$@"
